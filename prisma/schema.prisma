// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model AgencyLead {
  id             String   @id @default(uuid())
  firstName      String
  lastName       String
  email          String
  projectDetails String?
  createdAt      DateTime @default(now())

  @@map("agency_leads")
}
